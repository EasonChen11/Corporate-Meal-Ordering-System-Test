{
	auto_https disable_redirects
}

(routes) {
	handle /health {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Plain HTTP on :80 — accepts any Host header so the internal preview-router
# (which proxies with Host: mealorder-<env>-gateway) can reach the same routes.
:80 {
	import routes
}

# Local-dev HTTPS entry point. Browsers hitting https://localhost get the same
# routing tree with a self-signed cert.
https://localhost {
	tls internal
	import routes
}
