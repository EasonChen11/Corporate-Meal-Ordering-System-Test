pipeline {
  agent any
  options { timeout(time: 10, unit: 'MINUTES'); timestamps() }

  // Hourly defensive sweep. PR preview is disabled (TBD), so this should
  // normally be a no-op; it exists to clean stray mealorder-pr-* projects
  // if previews are temporarily re-enabled.
  triggers {
    cron('H * * * *')
  }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Hourly sweep') {
      steps {
        withCredentials([string(credentialsId: 'gh-pat', variable: 'GH_TOKEN')]) {
          sh '''
            set -euo pipefail
            bash scripts/preview-sweep-stale.sh
          '''
        }
      }
    }
  }
}
